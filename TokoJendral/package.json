{
  "name": "pos",
  "version": "1.0.0",
  "description": "POS & Inventory Management System with FIFO tracking and multi-role access",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "npx knex migrate:latest",
    "seed": "npx knex seed:run",
    "setup": "npx knex migrate:latest && npx knex seed:run",
    "reset": "npx knex migrate:rollback --all && npx knex migrate:latest && npx knex seed:run"
  },
