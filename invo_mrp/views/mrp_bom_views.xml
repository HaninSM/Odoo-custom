<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_form_inherit_textile" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.textile</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!-- Tambahkan Tab Spesifikasi Tekstil & HPP Kasir -->
            <xpath expr="//notebook" position="inside">
                <page string="Spesifikasi Konveksi &amp; HPP Kasir" name="textile_konveksi">
                    <group>
                        <group string="Karakteristik Bahan &amp; Kain">
                            <field name="x_is_textile_bom"/>
                            <field name="x_textile_pattern" placeholder="Misal: Motif Kotak Pastel / Floral Minimalis"/>
                            <field name="x_fabric_width_meter"/>
                            <field name="x_shrinkage_pct"/>
                        </group>
                        <group string="Koneksi Sistem Kasir (Invo POS)">
                            <field name="x_target_pos_item_id"/>
                            <field name="x_target_pos_unit_id"/>
                        </group>
                    </group>

                    <group string="Struktur Biaya &amp; HPP Komposit Standar">
                        <group>
                            <field name="x_std_labor_cost"/>
                            <field name="x_std_acc_cost"/>
                        </group>
                        <group>
                            <field name="x_total_material_cost" widget="monetary"/>
                            <field name="x_estimated_composite_hpp" widget="monetary" decoration-bf="1" decoration-success="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Tambahkan Kolom Peran Komponen Tekstil pada Tabel BoM Lines -->
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="x_component_role" optional="show"/>
                <field name="x_allow_waste" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
