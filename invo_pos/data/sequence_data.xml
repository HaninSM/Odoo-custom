<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Purchase Orders -->
        <record id="seq_x_pos_purchase" model="ir.sequence">
            <field name="name">Nomor Nota Pembelian POS</field>
            <field name="code">x_pos_purchase</field>
            <field name="prefix">PO-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for POS Cashier Orders -->
        <record id="seq_x_pos_order" model="ir.sequence">
            <field name="name">Nomor Struk Transaksi POS</field>
            <field name="code">x_pos_order</field>
            <field name="prefix">TRX-%(year)s%(month)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
